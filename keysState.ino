int k1_up_isPressedState() {
  return !digitalRead(K1_UP_PIN);
}


int k2_down_isPressedState() {
  return !digitalRead(K2_DOWN_PIN);
}


int k3_hash_isPressedState() {
  return !digitalRead(K3_HASH_PIN);
}


int k4_star_isPressedState() {
  return !digitalRead(K4_STAR_PIN);
}


int k5_blue_isPressedState() {
  return !digitalRead(K5_BLUE_PIN);
}
